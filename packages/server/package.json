{
  "name": "@ascii-web/server",
  "version": "0.9.0",
  "description": "Server-side ASCII art rendering for Astro, Next.js, and other Node.js frameworks",
  "author": "Raffaele Cataldo",
  "type": "module",
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "exports": {
    ".": {
      "import": "./dist/server.js",
      "types": "./dist/server.d.ts"
    }
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "tsc"
  },
  "dependencies": {
    "@ascii-web/wasm": "workspace:*"
  },
  "peerDependencies": {
    "sharp": ">=0.32.0"
  },
  "peerDependenciesMeta": {
    "sharp": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  },
  "keywords": [
    "ascii",
    "art",
    "server",
    "ssr",
    "astro",
    "wasm"
  ],
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/farmeroy/ascii-web.git",
    "directory": "packages/server"
  }
}
