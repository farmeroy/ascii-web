{
  "name": "ascii-web-root",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "build:wasm": "pnpm --filter @ascii-web/wasm build",
    "build:client": "pnpm --filter @ascii-web/client build",
    "build:server": "pnpm --filter @ascii-web/server build",
    "build:examples": "pnpm --filter @ascii-web/examples build",
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "test": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "vite": "^8.3.5"
  }
}
