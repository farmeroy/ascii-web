{
  "name": "rascii-img",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/ascii-img.js",
  "types": "./dist/ascii-img.d.ts",
  "exports": {
    ".": {
      "import": "./dist/ascii-img.js",
      "types": "./dist/ascii-img.d.ts"
    }
  },
  "files": [
    "dist/",
    "pkg/"
  ],
  "scripts": {
    "build:wasm": "wasm-pack build --target web",
    "build:ts": "tsc",
    "build": "npm run build:wasm && npm run build:ts",
    "dev": "npx serve .",
    "dev:ts": "tsc --watch"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  },
  "sideEffects": true,
  "keywords": [
    "ascii",
    "art",
    "image",
    "wasm",
    "web-component"
  ],
  "license": "MIT OR Apache-2.0"
}
